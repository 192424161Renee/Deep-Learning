import numpy as np
from sklearn.neural_network import BernoulliRBM

X = np.random.randint(0,2,(100,8))

rbm1 = BernoulliRBM(n_components=6, n_iter=10, random_state=42)
rbm1.fit(X)

H1 = rbm1.transform(X)

rbm2 = BernoulliRBM(n_components=3, n_iter=10, random_state=42)
rbm2.fit(H1)

H2 = rbm2.transform(H1)

print("Original Data:\n", X[:3])
print("First Layer:\n", H1[:3])
print("Deep Representation:\n", H2[:3])
