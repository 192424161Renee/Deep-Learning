import tensorflow as tf
import numpy as np

model = tf.keras.Sequential([
    tf.keras.layers.SimpleRNN(16, input_shape=(5,1)),
    tf.keras.layers.Dense(1)
])

model.compile(optimizer=tf.keras.optimizers.Adam(clipnorm=1.0), loss='mse')

X = np.random.rand(100,5,1)
y = np.random.rand(100,1)

history = model.fit(X, y, epochs=5, verbose=0)

print("Gradient Clipping Applied")
print("Final Loss:", history.history['loss'][-1])
